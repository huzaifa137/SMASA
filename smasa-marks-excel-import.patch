@@ -0,0 +1,35 @@
+<?php
+
+namespace App\Exports;
+
+use Maatwebsite\Excel\Concerns\FromArray;
+use Maatwebsite\Excel\Concerns\ShouldAutoSize;
+use Maatwebsite\Excel\Concerns\WithStyles;
+use Maatwebsite\Excel\Concerns\WithTitle;
+use PhpOffice\PhpSpreadsheet\Worksheet\Worksheet;
+
+/**
+ * Marks-import template for one class-stream: one row per pupil (with the system ID, so re-importing can never
+ * attach a mark to the wrong child), one column per examinable subject, current marks pre-filled.
+ */
+class MarksImportTemplateExport implements FromArray, WithStyles, ShouldAutoSize, WithTitle
+{
+    public function __construct(private array $subjectNames, private array $rows, private string $title = 'Marks')
+    {
+    }
+
+    public function array(): array
+    {
+        return array_merge([array_merge(['Student ID', 'First Name', 'Last Name'], $this->subjectNames)], $this->rows);
+    }
+
+    public function title(): string
+    {
+        return mb_substr(preg_replace('/[\\\\\/\?\*\[\]:]/', ' ', $this->title), 0, 31) ?: 'Marks';
+    }
+
+    public function styles(Worksheet $sheet)
+    {
+        return [1 => ['font' => ['bold' => true]]];
+    }
+}
diff --git a/app/Http/Controllers/ExaminationMarksImportController.php b/app/Http/Controllers/ExaminationMarksImportController.php
new file mode 100644
index 0000000..5a4e99a
--- /dev/null
+++ b/app/Http/Controllers/ExaminationMarksImportController.php
@@ -0,0 +1,259 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Exports\MarksImportTemplateExport;
+use App\Helpers\PermissionHelper;
+use App\Models\Examination;
+use App\Models\ExaminationClass;
+use App\Models\ExaminationMark;
+use App\Services\ExaminationMarksImportService;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Support\Str;
+use Maatwebsite\Excel\Facades\Excel;
+use PhpOffice\PhpSpreadsheet\IOFactory;
+
+/**
+ * Examinations -> Marks Entry -> "Import marks from Excel".
+ *
+ * Step 1  pick a class-stream, download the template (or use your own marklist), upload it.
+ * Step 2  preview: columns matched to subjects, pupils matched, problems, what will change. Nothing is saved yet.
+ * Step 3  confirm: the marks are saved with the same grading as the Marks Entry screen.
+ */
+class ExaminationMarksImportController extends Controller
+{
+    public function __construct(private ExaminationMarksImportService $service)
+    {
+    }
+
+    public function index($examId)
+    {
+        $exam = $this->exam($examId);
+
+        return view('Examination.marks-import', [
+            'exam' => $exam,
+            'classOptions' => $this->classOptions($exam),
+            'selected' => null,
+            'plan' => null,
+        ]);
+    }
+
+    public function template(Request $request, $examId)
+    {
+        $exam = $this->exam($examId);
+        [$classId, $streamId] = $this->classStream($request, $exam);
+
+        $ctx = $this->service->importableSubjects($exam, $classId, $streamId, Session('LoggedTeacher'));
+        $subjects = $ctx['subjects'];
+
+        $marks = ExaminationMark::where('examination_id', $exam->id)
+            ->where('school_id', $exam->school_id)
+            ->where('class_id', $classId)
+            ->where('stream_id', $streamId)
+            ->get()
+            ->keyBy(fn($m) => $m->student_id . '|' . ($m->custom_subject_id ?? 0) . '|' . ($m->subject_id ?? 0));
+
+        $rows = [];
+        foreach ($this->service->students($exam, $classId, $streamId) as $s) {
+            $line = [$s['id'], $s['firstname'], $s['lastname']];
+            foreach ($subjects as $sub) {
+                $m = $marks->get($s['id'] . '|' . ($sub['row']->custom_subject_id ?? 0) . '|' . ($sub['row']->subject_id ?? 0));
+                $line[] = $m && $m->marks_obtained !== null ? (float) $m->marks_obtained : null;
+            }
+            $rows[] = $line;
+        }
+
+        $file = 'marks-' . Str::slug(Helper::recordMdname($classId) . '-' . $streamId . '-' . $exam->exam_name) . '.xlsx';
+
+        return Excel::download(new MarksImportTemplateExport(array_column($subjects, 'name'), $rows, Helper::recordMdname($classId) . ' ' . $streamId), $file);
+    }
+
+    /** Upload (new file) or re-check (same file, other sheet / other column choices). */
+    public function preview(Request $request, $examId)
+    {
+        $exam = $this->exam($examId);
+        [$classId, $streamId] = $this->classStream($request, $exam);
+        $this->requireOpen($exam);
+
+        $request->validate([
+            'file' => 'nullable|file|mimes:xlsx,xls,csv,txt|max:8192',
+            'token' => ['nullable', 'regex:/^[A-Za-z0-9]{40}\.(xlsx|xls|csv|txt)$/'],
+        ]);
+
+        $schoolId = $exam->school_id;
+        $token = $request->input('token');
+
+        if ($request->hasFile('file')) {
+            $ext = strtolower($request->file('file')->getClientOriginalExtension() ?: 'xlsx');
+            $token = Str::random(40) . '.' . $ext;
+            $request->file('file')->storeAs("marks-imports/{$schoolId}", $token, 'local');
+        }
+        if (!$token || !Storage::disk('local')->exists("marks-imports/{$schoolId}/{$token}")) {
+            return back()->with('error', 'Please choose the file to import.')->withInput();
+        }
+
+        try {
+            [$sheetNames, $rows, $sheetIndex] = $this->readSheet($schoolId, $token, $request->input('sheet'), $classId, $streamId);
+        } catch (\Throwable $e) {
+            report($e);
+            return back()->with('error', 'That file could not be read. Please upload an .xlsx or .csv file.')->withInput();
+        }
+
+        $mapping = $request->has('map') ? $this->cleanMapping($request->input('map')) : null;
+        $plan = $this->service->buildPlan($exam, $classId, $streamId, $rows, $mapping, $request->boolean('overwrite'), Session('LoggedTeacher'));
+
+        return view('Examination.marks-import', [
+            'exam' => $exam,
+            'classOptions' => $this->classOptions($exam),
+            'selected' => ['class_id' => $classId, 'stream_id' => $streamId, 'token' => $token, 'sheets' => $sheetNames, 'sheet' => $sheetIndex, 'overwrite' => $request->boolean('overwrite')],
+            'plan' => $plan,
+        ]);
+    }
+
+    public function commit(Request $request, $examId)
+    {
+        $exam = $this->exam($examId);
+        [$classId, $streamId] = $this->classStream($request, $exam);
+        $this->requireOpen($exam);
+
+        $request->validate(['token' => ['required', 'regex:/^[A-Za-z0-9]{40}\.(xlsx|xls|csv|txt)$/']]);
+
+        $schoolId = $exam->school_id;
+        $token = $request->input('token');
+        if (!Storage::disk('local')->exists("marks-imports/{$schoolId}/{$token}")) {
+            return redirect()->route('examination.marks.import', $exam->id)->with('error', 'The uploaded file has expired. Please upload it again.');
+        }
+
+        try {
+            [, $rows] = $this->readSheet($schoolId, $token, $request->input('sheet'), $classId, $streamId);
+            $teacherId = Session('LoggedTeacher');
+            $plan = $this->service->buildPlan($exam, $classId, $streamId, $rows, $this->cleanMapping($request->input('map', [])), $request->boolean('overwrite'), $teacherId);
+
+            if (!$plan['ok'] || !$plan['changes']) {
+                return redirect()->route('examination.marks.import', $exam->id)->with('error', 'There is nothing to import.');
+            }
+
+            $saved = $this->service->commit($exam, $classId, $streamId, $plan, $teacherId);
+        } catch (\Throwable $e) {
+            report($e);
+            return redirect()->route('examination.marks.import', $exam->id)->with('error', 'The import failed and nothing was saved: ' . $e->getMessage());
+        }
+
+        try {
+            \App\Audit\Audit::log('marks_imported', "Imported {$saved} mark(s) from Excel into examination #{$exam->id}", [
+                'metadata' => ['examination_id' => $exam->id, 'class_id' => $classId, 'stream_id' => $streamId, 'marks' => $saved],
+            ]);
+        } catch (\Throwable $e) {
+            report($e);
+        }
+
+        Storage::disk('local')->delete("marks-imports/{$schoolId}/{$token}");
+
+        return redirect()->route('examination.marks.import', $exam->id)
+            ->with('success', "{$saved} mark(s) imported for " . Helper::recordMdname($classId) . ($streamId && $streamId !== '-' && $streamId !== 'NO_STREAM' ? " {$streamId}" : '') . '.');
+    }
+
+    // ── helpers ──────────────────────────────────────────────────────────────────
+
+    private function exam($examId): Examination
+    {
+        PermissionHelper::denyUnlessFeature('enter_marks');
+
+        $exam = Examination::where('id', $examId)->where('school_id', Session('LoggedSchool'))->firstOrFail();
+        $exam->syncStatus();
+
+        return $exam;
+    }
+
+    private function requireOpen(Examination $exam): void
+    {
+        if (!in_array($exam->status, ExaminationMarksImportService::OPEN_STATUSES, true)) {
+            abort(403, 'Marks entry is closed for this examination, so marks cannot be imported.');
+        }
+    }
+
+    /** The class-stream must be one of this examination's own. */
+    private function classStream(Request $request, Examination $exam): array
+    {
+        if ($request->filled('cs')) {                       // the class dropdown sends "classId|stream"
+            [$c, $st] = array_pad(explode('|', (string) $request->input('cs'), 2), 2, null);
+            $request->merge(['class_id' => $c, 'stream_id' => $st]);
+        }
+
+        $data = $request->validate(['class_id' => 'required|integer', 'stream_id' => 'required|string|max:50']);
+
+        ExaminationClass::where('examination_id', $exam->id)
+            ->where('school_id', $exam->school_id)
+            ->where('class_id', $data['class_id'])
+            ->where('stream_id', $data['stream_id'])
+            ->firstOrFail();
+
+        return [(int) $data['class_id'], (string) $data['stream_id']];
+    }
+
+    private function classOptions(Examination $exam)
+    {
+        return ExaminationClass::where('examination_id', $exam->id)
+            ->where('school_id', $exam->school_id)
+            ->get()
+            ->map(function ($ec) {
+                $stream = ($ec->stream_id && !in_array($ec->stream_id, ['-', 'NO_STREAM'], true)) ? ' ' . $ec->stream_id : '';
+
+                return ['class_id' => $ec->class_id, 'stream_id' => $ec->stream_id, 'label' => Helper::recordMdname($ec->class_id) . $stream];
+            })
+            ->sortBy('label', SORT_NATURAL | SORT_FLAG_CASE)
+            ->values();
+    }
+
+    /** @return array [sheetNames, rows, chosenIndex] */
+    private function readSheet($schoolId, string $token, $sheetParam, int $classId, string $streamId): array
+    {
+        $path = Storage::disk('local')->path("marks-imports/{$schoolId}/{$token}");
+        $reader = IOFactory::createReaderForFile($path);
+        $reader->setReadDataOnly(true);
+        $book = $reader->load($path);
+        $names = $book->getSheetNames();
+
+        $index = is_numeric($sheetParam) && isset($names[(int) $sheetParam]) ? (int) $sheetParam : $this->guessSheet($names, $classId, $streamId);
+        $rows = $book->getSheet($index)->toArray(null, true, false, false);
+        $book->disconnectWorksheets();
+
+        return [$names, $rows, $index];
+    }
+
+    /** Several-sheet marklist: start on the sheet whose name matches the chosen class (e.g. "PRI FOUR-EAST"). */
+    private function guessSheet(array $names, int $classId, string $streamId): int
+    {
+        $norm = fn($s) => preg_replace('/[^A-Z0-9]/', '', strtoupper($s));
+        $class = $norm(Helper::recordMdname($classId));
+        $stream = in_array($streamId, ['-', 'NO_STREAM'], true) ? '' : $norm($streamId);
+
+        foreach ($names as $i => $n) {
+            $x = $norm($n);
+            if ($x === $class . $stream || $x === $norm($class . $stream)) {
+                return $i;
+            }
+        }
+        foreach ($names as $i => $n) {
+            $x = $norm($n);
+            if ($stream !== '' && str_contains($x, $stream) && str_contains($x, $class)) {
+                return $i;
+            }
+        }
+
+        return 0;
+    }
+
+    private function cleanMapping($map): array
+    {
+        $out = [];
+        foreach ((array) $map as $col => $v) {
+            if (is_numeric($col)) {
+                $out[(int) $col] = ($v === '' || $v === null) ? '' : (int) $v;
+            }
+        }
+
+        return $out;
+    }
+}
diff --git a/app/Services/ExaminationMarksImportService.php b/app/Services/ExaminationMarksImportService.php
new file mode 100644
index 0000000..1decda8
--- /dev/null
+++ b/app/Services/ExaminationMarksImportService.php
@@ -0,0 +1,337 @@
+<?php
+
+namespace App\Services;
+
+use App\Helpers\PermissionHelper;
+use App\Http\Controllers\Helper;
+use App\Models\AssessmentScale;
+use App\Models\Examination;
+use App\Models\ExaminationClass;
+use App\Models\ExaminationMark;
+use App\Models\ExaminationSubjectSetting;
+use App\Support\MarksSheetParser as Parser;
+use Illuminate\Support\Facades\DB;
+
+/**
+ * Import the marks of one class-stream for one examination from an Excel/CSV sheet.
+ *
+ * It follows the Marks Entry screen's rules exactly (same grade bands, same Early-Years scale handling, same
+ * "subject not sat" / eligible-pupil / paper-teacher checks, same ExaminationMark::updateOrCreate keys) and
+ * never creates pupils or subjects. Subjects that save per-paper marks, and Secondary O-Level assessment
+ * subjects, are reported and skipped - those keep using the Marks Entry screen.
+ *
+ * Two phases so nothing is written until the user has seen the preview:
+ *   buildPlan()  - read-only: matches pupils, maps columns, validates cells, says what would change.
+ *   commit()     - re-builds the plan from the same file (never trusts the browser) and writes it in one transaction.
+ */
+class ExaminationMarksImportService
+{
+    public const OPEN_STATUSES = ['marks_entry', 'active'];
+
+    /** @return array ['subjects'=>list, 'skipped'=>list of ['name','reason']] */
+    public function importableSubjects(Examination $exam, int $classId, string $streamId, $teacherId): array
+    {
+        $schoolId = $exam->school_id;
+        $examClass = $this->examClass($exam, $classId, $streamId);
+
+        $rows = DB::table('class_subjects')
+            ->where('school_id', $schoolId)
+            ->where('class_id', $classId)
+            ->where('stream_id', $streamId)
+            ->orderBy('id')
+            ->get();
+
+        $subjects = [];
+        $skipped = [];
+
+        foreach ($rows as $cs) {
+            $name = Helper::classSubjectName($cs);
+            $code = $cs->custom_subject_id
+                ? DB::table('custom_subjects')->where('id', $cs->custom_subject_id)->value('subject_code')
+                : null;
+            $code = ($code && preg_match('/^[\x20-\x7E]+$/', $code)) ? $code : null;   // Arabic codes are display-only
+
+            if (!ExaminationSubjectSetting::marksEntryOpen($exam->id, $cs)) {
+                $skipped[] = ['name' => $name, 'reason' => 'not being examined in this examination'];
+                continue;
+            }
+            if ($cs->subject_type === 'secondary_olevel' && $exam->usesNlscAssessments()) {
+                $skipped[] = ['name' => $name, 'reason' => 'O-Level assessment subject - use Marks Entry'];
+                continue;
+            }
+            $scale = $cs->assessment_scale_id ? AssessmentScale::with('presets')->find($cs->assessment_scale_id) : null;
+
+            // Same condition ExaminationController::saveMarks() uses to switch to per-paper saving.
+            if ((!$scale || $scale->supportsPapers())
+                && ExaminationPaperService::supports($exam, $classId)
+                && ExaminationPaperService::papers($exam, $classId, $streamId, $cs->subject_id, $cs->custom_subject_id)->isNotEmpty()) {
+                $skipped[] = ['name' => $name, 'reason' => 'marks are entered per paper - use Marks Entry'];
+                continue;
+            }
+            $paperAccess = PaperTeacherAccess::forActor($cs, $teacherId, PermissionHelper::canFeature('manage_exam_subjects'));
+            if ($paperAccess && !PaperTeacherAccess::canEnterSingleScore($paperAccess)) {
+                $skipped[] = ['name' => $name, 'reason' => 'papers are assigned to other teachers'];
+                continue;
+            }
+
+            $subjects[] = [
+                'key' => (int) $cs->id,
+                'name' => $name,
+                'code' => $code,
+                'row' => $cs,
+                'scale' => $scale,
+                'min' => $scale ? (float) $scale->min_score : 0.0,
+                'max' => $scale ? (float) $scale->max_score : (float) $exam->total_marks,
+                'eligible' => Helper::studentIdsTakingClassSubject($schoolId, $cs),   // null = every pupil
+                'bands' => $this->bandsFor($exam, $examClass, $schoolId, $cs),
+            ];
+        }
+
+        return ['subjects' => $subjects, 'skipped' => $skipped];
+    }
+
+    public function students(Examination $exam, int $classId, string $streamId): array
+    {
+        return DB::table('students')
+            ->where('school_id', $exam->school_id)
+            ->where('senior', $classId)
+            ->where('stream', $streamId)
+            ->orderBy('firstname')->orderBy('lastname')
+            ->get(['id', 'firstname', 'lastname'])
+            ->map(fn($s) => ['id' => (int) $s->id, 'firstname' => (string) $s->firstname, 'lastname' => (string) $s->lastname])
+            ->all();
+    }
+
+    /**
+     * @param array $sheetRows 2-D cell array of the chosen sheet
+     * @param array $mapping   [sheet column index => class_subjects.id | '' (ignore)]; null = use the automatic guess
+     */
+    public function buildPlan(Examination $exam, int $classId, string $streamId, array $sheetRows, ?array $mapping, bool $overwrite, $teacherId): array
+    {
+        $ctx = $this->importableSubjects($exam, $classId, $streamId, $teacherId);
+        $subjects = collect($ctx['subjects'])->keyBy('key');
+        $students = $this->students($exam, $classId, $streamId);
+
+        $layout = Parser::detectLayout($sheetRows);
+        if (!$layout) {
+            return ['ok' => false, 'error' => 'Could not find a header row with pupil names in this sheet. The sheet needs a "First Name" and "Last Name" (or "Name") column.', 'skipped_subjects' => $ctx['skipped']];
+        }
+
+        // Column -> subject. Automatic guess first; each subject is taken by one column only (the left-most), so a
+        // second block repeating "ENG / MTC" further right is ignored instead of overwriting the first.
+        $auto = [];
+        $taken = [];
+        foreach ($layout['columns'] as $col => $label) {
+            $key = Parser::matchSubject($label, array_values(array_map(fn($s) => ['key' => $s['key'], 'name' => $s['name'], 'code' => $s['code']], $subjects->all())));
+            if ($key !== null && !isset($taken[$key])) {
+                $auto[$col] = $key;
+                $taken[$key] = true;
+            }
+        }
+        $chosen = [];
+        foreach ($layout['columns'] as $col => $label) {
+            $v = $mapping === null ? ($auto[$col] ?? '') : ($mapping[$col] ?? '');
+            $chosen[$col] = ($v !== '' && $subjects->has((int) $v)) ? (int) $v : '';
+        }
+        // a subject picked on two columns: keep the left-most
+        $seen = [];
+        $duplicateCols = [];
+        foreach ($chosen as $col => $key) {
+            if ($key === '') {
+                continue;
+            }
+            if (isset($seen[$key])) {
+                $chosen[$col] = '';
+                $duplicateCols[] = $col;
+            }
+            $seen[$key] = true;
+        }
+
+        $existing = ExaminationMark::where('examination_id', $exam->id)
+            ->where('school_id', $exam->school_id)
+            ->where('class_id', $classId)
+            ->where('stream_id', $streamId)
+            ->get()
+            ->keyBy(fn($m) => $m->student_id . '|' . ($m->custom_subject_id ?? 0) . '|' . ($m->subject_id ?? 0));
+
+        $rows = Parser::readRows($sheetRows, $layout);
+        $problems = [];
+        $changes = [];
+        $stats = ['sheet_rows' => count($rows), 'pupils_matched' => 0, 'pupils_unmatched' => 0, 'new' => 0, 'updated' => 0, 'same' => 0, 'kept' => 0, 'blank' => 0, 'absent' => 0, 'invalid' => 0, 'not_taking' => 0];
+        $used = [];
+
+        foreach ($rows as $row) {
+            $match = Parser::matchStudent($row, $students);
+            $display = trim($row['first'] . ' ' . $row['middle'] . ' ' . $row['last']);
+
+            if ($match['status'] !== 'ok') {
+                $stats['pupils_unmatched']++;
+                $problems[] = [
+                    'line' => $row['line'], 'type' => $match['status'] === 'ambiguous' ? 'Name matches several pupils' : 'Pupil not found in this class',
+                    'name' => $display,
+                    'detail' => $match['suggestions']
+                        ? 'Did you mean: ' . implode(' / ', array_map(fn($s) => $s['firstname'] . ' ' . $s['lastname'], $match['suggestions'])) . '?'
+                        : 'Add the pupil first (or correct the spelling in the sheet).',
+                ];
+                continue;
+            }
+            $student = $match['student'];
+            if (isset($used[$student['id']])) {
+                $problems[] = ['line' => $row['line'], 'type' => 'Pupil appears twice in the sheet', 'name' => $display, 'detail' => 'Only the first row (line ' . $used[$student['id']] . ') is used.'];
+                continue;
+            }
+            $used[$student['id']] = $row['line'];
+            $stats['pupils_matched']++;
+
+            foreach ($chosen as $col => $key) {
+                if ($key === '') {
+                    continue;
+                }
+                $subject = $subjects[$key];
+                $cell = Parser::parseMark($row['cells'][$col] ?? null, $subject['min'], $subject['max']);
+
+                if ($cell['state'] === 'blank') {
+                    $stats['blank']++;
+                    continue;
+                }
+                if ($cell['state'] === 'absent') {
+                    $stats['absent']++;
+                    continue;
+                }
+                if ($cell['state'] === 'invalid') {
+                    $stats['invalid']++;
+                    $problems[] = ['line' => $row['line'], 'type' => 'Invalid mark', 'name' => $display,
+                        'detail' => $subject['name'] . ': "' . $cell['raw'] . '" is not a number from ' . rtrim(rtrim(number_format($subject['min'], 2, '.', ''), '0'), '.') . ' to ' . rtrim(rtrim(number_format($subject['max'], 2, '.', ''), '0'), '.') . '.'];
+                    continue;
+                }
+                if ($subject['eligible'] !== null && !$subject['eligible']->contains($student['id'])) {
+                    $stats['not_taking']++;
+                    $problems[] = ['line' => $row['line'], 'type' => 'Pupil does not take this subject', 'name' => $display, 'detail' => $subject['name'] . ' skipped.'];
+                    continue;
+                }
+
+                $old = $existing->get($student['id'] . '|' . ($subject['row']->custom_subject_id ?? 0) . '|' . ($subject['row']->subject_id ?? 0));
+                $oldVal = $old && $old->marks_obtained !== null ? (float) $old->marks_obtained : null;
+
+                if ($oldVal !== null && abs($oldVal - $cell['value']) < 0.005) {
+                    $stats['same']++;
+                    continue;
+                }
+                if ($oldVal !== null && !$overwrite) {
+                    $stats['kept']++;
+                    continue;
+                }
+
+                $oldVal === null ? $stats['new']++ : $stats['updated']++;
+                $changes[] = ['student_id' => $student['id'], 'student' => $student['firstname'] . ' ' . $student['lastname'], 'subject_key' => $key, 'subject' => $subject['name'], 'old' => $oldVal, 'new' => $cell['value']];
+            }
+        }
+
+        return [
+            'ok' => true, 'layout' => $layout, 'chosen' => $chosen, 'auto' => $auto, 'duplicate_cols' => $duplicateCols,
+            'subjects' => $subjects->map(fn($s) => ['key' => $s['key'], 'name' => $s['name']])->values()->all(),
+            'skipped_subjects' => $ctx['skipped'], 'stats' => $stats, 'problems' => $problems, 'changes' => $changes,
+        ];
+    }
+
+    /** Write a plan produced by buildPlan(). Returns the number of marks saved. */
+    public function commit(Examination $exam, int $classId, string $streamId, array $plan, $teacherId): int
+    {
+        $ctx = collect($this->importableSubjects($exam, $classId, $streamId, $teacherId))->get('subjects');
+        $subjects = collect($ctx)->keyBy('key');
+        $schoolId = $exam->school_id;
+        $saved = 0;
+
+        DB::transaction(function () use ($plan, $subjects, $exam, $classId, $streamId, $schoolId, $teacherId, &$saved) {
+            foreach ($plan['changes'] as $c) {
+                $subject = $subjects->get($c['subject_key']);
+                if (!$subject) {
+                    continue;
+                }
+                [$grade, $remark, $points, $total, $value] = $this->grade((float) $c['new'], $exam, $subject);
+
+                ExaminationMark::updateOrCreate(
+                    [
+                        'examination_id' => $exam->id,
+                        'student_id' => $c['student_id'],
+                        'subject_id' => $subject['row']->subject_id,
+                        'custom_subject_id' => $subject['row']->custom_subject_id,
+                    ],
+                    [
+                        'class_id' => $classId,
+                        'stream_id' => $streamId,
+                        'school_id' => $schoolId,
+                        'marks_obtained' => $value,
+                        'total_marks' => $total,
+                        'grade' => $grade,
+                        'grade_remark' => $remark,
+                        'grade_points' => $points,
+                        'entered_by' => $teacherId,
+                        'entered_at' => now(),
+                        'status' => 'entered',
+                    ]
+                );
+                $saved++;
+            }
+        });
+
+        return $saved;
+    }
+
+    // ── internals ────────────────────────────────────────────────────────────────
+
+    private function examClass(Examination $exam, int $classId, string $streamId): ?ExaminationClass
+    {
+        return ExaminationClass::where('examination_id', $exam->id)
+            ->where('school_id', $exam->school_id)
+            ->where('class_id', $classId)
+            ->where('stream_id', $streamId)
+            ->first();
+    }
+
+    /** Same resolution as ExaminationController::saveMarks(). */
+    private function bandsFor(Examination $exam, ?ExaminationClass $examClass, $schoolId, $cs)
+    {
+        $bands = $examClass ? $examClass->resolvedGradingBands() : $exam->resolvedGradingBands();
+
+        return PassFailGradingService::scale($schoolId, $bands, $cs->subject_id, $cs->custom_subject_id);
+    }
+
+    /** @return array [grade, remark, points, total_marks, marks_value]  - mirrors ExaminationController::saveMarks() */
+    private function grade(float $marks, Examination $exam, array $subject): array
+    {
+        $scale = $subject['scale'];
+
+        if ($scale) {
+            $total = $scale->max_score;
+            $marks = $scale->allow_custom_score
+                ? $scale->normalizeScore($marks)
+                : max((float) $scale->min_score, min((float) $scale->max_score, round($marks)));
+            $preset = $scale->presetForScore($marks);
+            $remark = $preset->remark ?? null;
+            $grade = null;
+            $points = null;
+
+            if ($scale->usesLinkedGrading()) {
+                $percentage = $scale->max_score > 0 ? round(($marks / $scale->max_score) * 100, 4) : 0;
+                $band = $scale->gradingScheme->bands->first(fn($g) => $percentage >= $g->min_mark && $percentage <= $g->max_mark);
+                if ($band) {
+                    $grade = $band->grade;
+                    $points = $band->points;
+                    $remark = $remark ?? $band->remark;
+                }
+            }
+
+            return [$grade, $remark, $points, $total, $marks];
+        }
+
+        $percentage = $exam->total_marks > 0 ? round(($marks / $exam->total_marks) * 100, 4) : 0;
+        $row = $subject['bands']->first(fn($g) => $percentage >= $g->min_mark && $percentage <= $g->max_mark);
+
+        if ($row) {
+            return [$row->grade, $row->remark, $row->points, $exam->total_marks, $marks];
+        }
+
+        return ['Ungraded', "No grade band covers {$percentage}% — check the exam's grading scheme.", null, $exam->total_marks, $marks];
+    }
+}
diff --git a/app/Support/MarksSheetParser.php b/app/Support/MarksSheetParser.php
new file mode 100644
index 0000000..6c41524
--- /dev/null
+++ b/app/Support/MarksSheetParser.php
@@ -0,0 +1,280 @@
+<?php
+
+namespace App\Support;
+
+/**
+ * Pure helpers (no database, no framework) for reading a marks spreadsheet:
+ *   - finds the header row and the name / ID / subject columns, whether the
+ *     sheet is the SMASA template or a school's own marklist layout
+ *     (subject name on one row, "MRK" / "Agg" underneath),
+ *   - reads the pupil rows,
+ *   - matches a row to a pupil of the class,
+ *   - turns a cell into a mark.
+ *
+ * Everything takes and returns plain arrays so it can be unit-tested with
+ * nothing but PHP (see tests/Unit/MarksSheetParserTest.php).
+ */
+class MarksSheetParser
+{
+    /** Header cells that are never a subject. */
+    private const IGNORED = [
+        'STR', 'STREAM', 'AGG', 'AGGREGATE', 'TT', 'TOTAL', 'TOTALMARKS', 'AVG', 'AVERAGE', 'GD', 'GRADE', 'PST', 'POS',
+        'POSITION', 'DIV', 'DIVISION', 'REMARK', 'REMARKS', 'COMMENT', 'COMMENTS', 'GENDER', 'SEX', 'NO', 'SN', 'S', 'NUMBER',
+        'MIDDLENAME', 'MIDDLE', 'FIRSTNAME', 'LASTNAME', 'SURNAME', 'NAME', 'STUDENTNAME', 'FULLNAME', 'STUDENTID', 'ID',
+    ];
+
+    /** Header cells that mean "the mark for the subject named above this cell". */
+    private const MARK_WORDS = ['MRK', 'MRKS', 'MARK', 'MARKS', 'SCORE', 'SCORES'];
+
+    /** A "name" that is really a summary line under the list. */
+    private const SUMMARY_ROWS = ['CLASSAVG', 'CLASSAVERAGE', 'AVERAGE', 'CLASSMEAN', 'MEAN', 'TOTAL', 'TOTALS', 'ANALYSIS', 'SUBJECT', 'DISPLAYID'];
+
+    /** Cell contents that mean "did not sit", not "zero". */
+    private const ABSENT = ['', '-', '--', 'X', 'AB', 'ABS', 'ABSENT', 'NA', 'N/A', 'NIL'];
+
+    /** Upper-case letters and digits only, so "Kibwika  Adam" == "KIBWIKA ADAM" == "kibwika-adam". */
+    public static function norm($value): string
+    {
+        return preg_replace('/[^A-Z0-9]/', '', strtoupper(trim((string) $value)));
+    }
+
+    /**
+     * Locate the header row and columns.
+     *
+     * @param  array $rows  2-D array of cell values (row-major), 0-indexed.
+     * @return array|null   ['header_row'=>int, 'id'=>?int, 'first'=>?int, 'middle'=>?int, 'last'=>?int, 'name'=>?int,
+     *                       'columns'=>[colIndex => label]]   (null when no header row is found)
+     */
+    public static function detectLayout(array $rows): ?array
+    {
+        $limit = min(count($rows), 40);
+
+        for ($r = 0; $r < $limit; $r++) {
+            $cells = array_map([self::class, 'norm'], array_values($rows[$r]));
+            $first = self::firstIndex($cells, ['FIRSTNAME', 'FIRST', 'FNAME', 'GIVENNAME', 'GIVENNAMES']);
+            $last = self::firstIndex($cells, ['LASTNAME', 'SURNAME', 'LAST', 'LNAME', 'SECONDNAME']);
+            $name = self::firstIndex($cells, ['NAME', 'STUDENTNAME', 'FULLNAME', 'PUPILNAME', 'LEARNERNAME', 'NAMES']);
+            $id = self::firstIndex($cells, ['STUDENTID', 'SYSTEMID', 'ID', 'PUPILID']);
+
+            $hasName = ($first !== null && $last !== null) || $name !== null || ($first !== null) || ($last !== null);
+            if (!$hasName) {
+                continue;
+            }
+
+            $middle = self::firstIndex($cells, ['MIDDLENAME', 'MIDDLE', 'OTHERNAMES', 'OTHERNAME']);
+            $nameCols = array_filter([$id, $first, $middle, $last, $name], fn($v) => $v !== null);
+
+            $columns = [];
+            foreach ($cells as $c => $cell) {
+                if (in_array($c, $nameCols, true)) {
+                    continue;
+                }
+                $label = null;
+                $headerText = trim((string) $rows[$r][$c]);
+                if (strlen($headerText) > 40) {
+                    continue;                   // an instruction / note cell, not a subject
+                }
+                if ($cell !== '' && (in_array($cell, self::MARK_WORDS, true) || ctype_digit($cell))) {
+                    // "MRK" under a subject name: the subject is written above, on the nearest filled cell
+                    for ($up = $r - 1; $up >= max(0, $r - 4); $up--) {
+                        $above = trim((string) ($rows[$up][$c] ?? ''));
+                        if ($above !== '') {
+                            $label = $above;
+                            break;
+                        }
+                    }
+                } elseif ($cell !== '' && !in_array($cell, self::IGNORED, true)) {
+                    $label = trim((string) $rows[$r][$c]);
+                }
+                if ($label !== null && !in_array(self::norm($label), self::IGNORED, true)) {
+                    $columns[$c] = $label;
+                }
+            }
+
+            if ($columns) {
+                return ['header_row' => $r, 'id' => $id, 'first' => $first, 'middle' => $middle, 'last' => $last, 'name' => $name, 'columns' => $columns];
+            }
+        }
+
+        return null;
+    }
+
+    /**
+     * Pupil rows below the header.
+     *
+     * @return array list of ['line'=>int (1-based sheet row), 'id'=>?int, 'first'=>string, 'middle'=>string, 'last'=>string, 'cells'=>[col=>raw]]
+     */
+    public static function readRows(array $rows, array $layout): array
+    {
+        $out = [];
+        $blankRun = 0;
+        for ($r = $layout['header_row'] + 1; $r < count($rows); $r++) {
+            $row = $rows[$r];
+            $cell = fn($i) => $i === null ? '' : trim((string) ($row[$i] ?? ''));
+
+            $first = $cell($layout['first']);
+            $middle = $cell($layout['middle']);
+            $last = $cell($layout['last']);
+            if ($layout['name'] !== null && $first === '' && $last === '') {
+                $last = $cell($layout['name']);
+            }
+            if ($first === '' && $last === '') {
+                // A blank line is skipped; two in a row after the list has started mean the list is over
+                // (what follows is usually a class-average / analysis block, never pupils).
+                if ($out && ++$blankRun >= 2) {
+                    break;
+                }
+                continue;
+            }
+            $blankRun = 0;
+            if (in_array(self::norm($first . $middle . $last), self::SUMMARY_ROWS, true)) {
+                continue;
+            }
+
+            $idRaw = $cell($layout['id']);
+            $cells = [];
+            foreach ($layout['columns'] as $c => $_) {
+                $cells[$c] = $row[$c] ?? null;
+            }
+
+            $out[] = [
+                'line' => $r + 1,
+                'id' => ctype_digit($idRaw) ? (int) $idRaw : null,
+                'first' => $first, 'middle' => $middle, 'last' => $last,
+                'cells' => $cells,
+            ];
+        }
+
+        return $out;
+    }
+
+    /**
+     * Find the pupil a sheet row refers to. Exact matches only (in either name order, with or without the
+     * middle name) - a "close" name is reported as a suggestion, never applied.
+     *
+     * @param array $students list of ['id'=>int,'firstname'=>string,'lastname'=>string]
+     * @return array ['status'=>'ok'|'ambiguous'|'unmatched', 'student'=>?array, 'candidates'=>[ids], 'suggestions'=>[students]]
+     */
+    public static function matchStudent(array $row, array $students): array
+    {
+        if ($row['id'] !== null) {
+            foreach ($students as $s) {
+                if ((int) $s['id'] === $row['id']) {
+                    return ['status' => 'ok', 'student' => $s, 'candidates' => [$s['id']], 'suggestions' => []];
+                }
+            }
+            return ['status' => 'unmatched', 'student' => null, 'candidates' => [], 'suggestions' => []];
+        }
+
+        $keys = array_unique(array_filter([
+            self::norm($row['first'] . $row['last']),
+            self::norm($row['last'] . $row['first']),
+            self::norm($row['first'] . $row['middle'] . $row['last']),
+            self::norm($row['last'] . $row['middle'] . $row['first']),
+            self::norm($row['middle'] . $row['first'] . $row['last']),
+            self::norm($row['first'] . $row['last'] . $row['middle']),
+        ]));
+
+        $hits = [];
+        foreach ($students as $s) {
+            $a = self::norm($s['firstname'] . $s['lastname']);
+            $b = self::norm($s['lastname'] . $s['firstname']);
+            if (in_array($a, $keys, true) || in_array($b, $keys, true)) {
+                $hits[] = $s;
+            }
+        }
+
+        if (count($hits) === 1) {
+            return ['status' => 'ok', 'student' => $hits[0], 'candidates' => [$hits[0]['id']], 'suggestions' => []];
+        }
+        if (count($hits) > 1) {
+            return ['status' => 'ambiguous', 'student' => null, 'candidates' => array_column($hits, 'id'), 'suggestions' => $hits];
+        }
+
+        $probe = self::norm($row['first'] . $row['last']);
+        $scored = [];
+        foreach ($students as $s) {
+            similar_text($probe, self::norm($s['firstname'] . $s['lastname']), $p1);
+            similar_text($probe, self::norm($s['lastname'] . $s['firstname']), $p2);
+            $p = max($p1, $p2);
+            if ($p >= 75) {
+                $scored[] = [$p, $s];
+            }
+        }
+        usort($scored, fn($x, $y) => $y[0] <=> $x[0]);
+
+        return ['status' => 'unmatched', 'student' => null, 'candidates' => [], 'suggestions' => array_map(fn($x) => $x[1], array_slice($scored, 0, 2))];
+    }
+
+    /**
+     * Guess which class subject a sheet column is for.
+     *
+     * @param array $subjects list of ['key'=>mixed,'name'=>string,'code'=>?string]
+     * @return mixed|null the matching subject's key
+     */
+    public static function matchSubject(string $label, array $subjects)
+    {
+        $l = self::norm($label);
+        if ($l === '') {
+            return null;
+        }
+        foreach ($subjects as $s) {
+            $variants = [self::norm($s['name']), self::norm($s['code'] ?? ''), self::norm($s['name'] . ($s['code'] ?? '')), self::norm($s['name'] . '(' . ($s['code'] ?? '') . ')')];
+            if (in_array($l, array_filter($variants), true)) {
+                return $s['key'];
+            }
+        }
+        // common school abbreviations
+        static $aliases = [
+            'MATHS' => 'MATHEMATICS', 'MATH' => 'MATHEMATICS', 'MTC' => 'MATHEMATICS', 'ENG' => 'ENGLISH', 'SCI' => 'INTEGRATEDSCIENCE',
+            'SCIENCE' => 'INTEGRATEDSCIENCE', 'SST' => 'SOCIALSTUDIES', 'LITI' => 'LITERACYI', 'LITII' => 'LITERACYII', 'LIT1' => 'LITERACYI',
+            'LIT2' => 'LITERACYII', 'LUG' => 'LUGANDA', 'RE' => 'RELIGIOUSEDUCATION', 'CRE' => 'RELIGIOUSEDUCATION', 'IRE' => 'RELIGIOUSEDUCATION',
+        ];
+        if (isset($aliases[$l])) {
+            foreach ($subjects as $s) {
+                if (self::norm($s['name']) === $aliases[$l]) {
+                    return $s['key'];
+                }
+            }
+        }
+
+        return null;
+    }
+
+    /**
+     * Interpret one cell.
+     *
+     * @return array ['state'=>'blank'|'absent'|'ok'|'invalid', 'value'=>?float, 'raw'=>string]
+     */
+    public static function parseMark($raw, float $min, float $max): array
+    {
+        $text = trim((string) $raw);
+        if ($raw === null || $text === '') {
+            return ['state' => 'blank', 'value' => null, 'raw' => ''];
+        }
+        if (in_array(strtoupper($text), self::ABSENT, true)) {
+            return ['state' => 'absent', 'value' => null, 'raw' => $text];
+        }
+        $num = str_replace(',', '.', $text);
+        if (!is_numeric($num)) {
+            return ['state' => 'invalid', 'value' => null, 'raw' => $text];
+        }
+        $v = (float) $num;
+        if ($v < $min || $v > $max) {
+            return ['state' => 'invalid', 'value' => null, 'raw' => $text];
+        }
+
+        return ['state' => 'ok', 'value' => round($v, 2), 'raw' => $text];
+    }
+
+    private static function firstIndex(array $normCells, array $wanted): ?int
+    {
+        foreach ($normCells as $i => $c) {
+            if ($c !== '' && in_array($c, $wanted, true)) {
+                return $i;
+            }
+        }
+
+        return null;
+    }
+}
