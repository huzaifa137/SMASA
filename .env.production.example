# Settings for running SMASA at scale. Copy the lines you need into .env.
# (This repo has no .env.example; these are the keys the scaling work uses.)

# --- Redis: sessions, cache and queue (needs a Redis server and the PHP
#     "redis" extension, or: composer require predis/predis + REDIS_CLIENT=predis)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
SESSION_DRIVER=redis
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
# No Redis yet?  QUEUE_CONNECTION=database works too (tables are created by php artisan migrate).
# QUEUE_CONNECTION=sync keeps everything inline, exactly as before.

# --- Per-page query counter (turn on while investigating a slow page, then off)
QUERY_COUNTER=false
QUERY_WARN_THRESHOLD=60

# --- Error monitoring: composer require sentry/sentry-laravel, then
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# ...and/or log critical errors to Slack:
# LOG_STACK=single,slack
# LOG_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX
# LOG_SLACK_LEVEL=error

# --- Backups (php artisan smasa:backup, scheduled daily 01:30)
BACKUP_PATH=/var/backups/smasa
BACKUP_KEEP_DAYS=14
# Dedicated EMPTY scratch database for the weekly restore test. It is wiped
# every run: never the live database.
BACKUP_VERIFY_DATABASE=smasa_restore_test
